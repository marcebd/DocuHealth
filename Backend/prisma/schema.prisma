generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       BigInt     @id @default(autoincrement())
  email    String     @unique
  password String
  patients Patient[]
  userData user_data?
}

model user_data {
  id              BigInt      @id @default(autoincrement())
  first_name      String
  middle_name     String?
  last_name       String
  phone_number    String?
  specialty       String[]
  id_number       String
  date_of_birth   DateTime
  gender          Gender
  languages       String[]
  location        String[]
  biography       String
  user_id         BigInt      @unique
  profile_picture Bytes?
  education       Education[]
  user            User        @relation(fields: [user_id], references: [id])
}

model Education {
  id           BigInt    @id @default(autoincrement())
  institution  String
  degree       String
  user_data_id BigInt
  graduation   String
  userData     user_data @relation(fields: [user_data_id], references: [id])
}

model Patient {
  id                   BigInt                @id @default(autoincrement())
  firstName            String
  middleName           String?
  lastName             String
  gender               Gender?
  idNumber             String
  birthDate            DateTime
  email                String?
  picture              Bytes?
  userId               BigInt
  conditions           Condition[]
  user                 User                  @relation(fields: [userId], references: [id])
  prescriptions        Prescription[]
  visitNotes           VisitNote[]
  appointments         Appointment[]
}

model Appointment {
  id                     BigInt                @id @default(autoincrement())
  appointmentTime        DateTime?
  timeZone               String?
  notificationSettings   NotificationSettings[]
  patientId              BigInt
  patient                Patient               @relation(fields: [patientId], references: [id])
  type                   AppointmentType?
  conditions             Condition[]
  prescriptions          Prescription[]
  visitNotes             VisitNote[]
}

model NotificationSettings {
id BigInt @id @default(autoincrement())
number Int
frequency String
appointment Appointment? @relation(fields: [appointmentID], references: [id])
appointmentID BigInt?
}

enum AppointmentType {
  Routine
  CommonSickness
  RoutineSickness
  EmergencySickness
  Emergency
}

model VisitNote {
  id            BigInt       @id @default(autoincrement())
  date          DateTime
  notes         String
  patientId     BigInt
  patient       Patient      @relation(fields: [patientId], references: [id])
  appointmentId BigInt?      @map("appointment_id")
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
}

model Prescription {
  id            BigInt       @id @default(autoincrement())
  name          String
  dose          String
  instructions  String?
  patientId     BigInt
  dateEnd       DateTime?
  dateStart     DateTime?
  patient       Patient      @relation(fields: [patientId], references: [id])
  appointmentId BigInt?      @map("appointment_id")
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
}

model Condition {
  id            BigInt       @id @default(autoincrement())
  name          String
  patientId     BigInt
  dateEnd       DateTime?
  dateStart     DateTime?
  patient       Patient      @relation(fields: [patientId], references: [id])
  appointmentId BigInt?      @map("appointment_id")
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
}

enum Gender {
  Female
  Male
  Nonbinary
  DeclineToState
  Other
}
