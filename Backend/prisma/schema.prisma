// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       BigInt   @id @default(autoincrement()) @db.BigInt
  email    String   @unique
  password String
  userData user_data?
  patients Patient[]
}

enum Gender {
Female
Male
Nonbinary
DeclineToState
Other
}

model user_data {
  id       BigInt   @id @default(autoincrement()) @db.BigInt
  first_name String
  middle_name String?
  last_name String
  phone_number String?
  specialty String[]
  id_number String
  date_of_birth DateTime
  gender Gender
  languages String[]
  location String[]
  education Education[]
  biography String
  profile_picture Bytes?
  user_id BigInt @unique
  user User @relation(fields: [user_id], references: [id])
}

model Education {
  id           BigInt   @id @default(autoincrement()) @db.BigInt
  institution  String
  degree       String
  graduation   String
  user_data_id BigInt
  userData     user_data @relation(fields: [user_data_id], references: [id])
}

model Patient {
  id       BigInt   @id  @unique
  firstName String
  middleName String?
  lastName String
  idNumber String
  birthDate DateTime
  visitNotes VisitNote[]
  prescriptions Prescription[]
  conditions Condition[]
  userId BigInt @unique
  user User @relation(fields: [userId], references: [id])
}

model VisitNote {
  id        BigInt   @id @default(autoincrement()) @db.BigInt
  date      DateTime
  notes     String
  patientId BigInt @unique
  patient   Patient  @relation(fields: [patientId], references: [id])
}

model Prescription {
  id        BigInt   @id @default(autoincrement()) @db.BigInt
  name      String
  dose      String
  instructions String?
  date      DateTime
  patientId BigInt @unique
  patient   Patient  @relation(fields: [patientId], references: [id])
}

model Condition {
  id        BigInt   @id @default(autoincrement()) @db.BigInt
  name      String
  date      DateTime
  patientId BigInt @unique
  patient   Patient  @relation(fields: [patientId], references: [id])
}
